rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ---------- Funciones de ayuda ----------
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/correosAutorizados/$(request.auth.token.email));
    }

    function isValidTimestamp(ts) {
      return ts is timestamp;
    }

    // ---------- Reglas para correosAutorizados ----------
    match /correosAutorizados/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- Reglas para categorías ----------
    match /categorias/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Reglas para tips ----------
    match /tips/{tipId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Reglas para nodos ----------
    match /nodos/{nodoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Permitir lectura pública de subcolecciones (si las usas)
    match /tips/{tipId}/{subCol}/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /nodos/{nodoId}/{subCol}/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categorias/{catId}/{subCol}/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Denegar todo lo que no coincida explícitamente
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 