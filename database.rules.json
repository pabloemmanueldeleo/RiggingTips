{
  "rules": {
    ".read": false,
    ".write": false,
    "nodos": {
      ".read": true,
      ".write": "auth != null && root.child('correosAutorizados').child(auth.token.email.replace('.', '_')).exists()"
    },
    "correosAutorizados": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('correosAutorizados').child(auth.token.email.replace('.', '_')).exists()",
      "$email": {
        ".validate": "newData.isBoolean()"
      }
    },
    "tips": {
      ".read": true,
      ".write": "auth != null && root.child('correosAutorizados').child(auth.token.email.replace('.', '_')).exists()",
      "categorias": {
        ".read": true,
        ".write": "auth != null && root.child('correosAutorizados').child(auth.token.email.replace('.', '_')).exists()"
      },
      "contenido": {
        ".read": true,
        ".write": "auth != null && root.child('correosAutorizados').child(auth.token.email.replace('.', '_')).exists()",
        "$categoria": {
          ".read": true,
          ".write": "auth != null && root.child('correosAutorizados').child(auth.token.email.replace('.', '_')).exists()"
        }
      }
    }
  }
} 